<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <!--
                Nocturne canvas washing into a warm near-black. The previous ramp ended on the
                aurora navy #14264A, a colour the palette no longer contains.
            -->
            <gradient
                android:angle="0"
                android:endColor="#1A1C1F"
                android:startColor="#08090A" />
        </shape>
    </item>
    <item
        android:bottom="38dp"
        android:drawable="@drawable/ic_launcher_foreground"
        android:left="108dp"
        android:right="108dp"
        android:top="38dp" />
</layer-list>
