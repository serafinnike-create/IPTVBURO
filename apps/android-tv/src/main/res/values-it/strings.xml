    <string name="app_name">IPTV BURO</string>
    <string name="legal_title">Prima di iniziare</string>
    <string name="legal_body">IPTV BURO è soltanto un lettore multimediale, come qualsiasi altro player video. Non fornisce, ospita, rivende, indicizza né cerca canali, film, serie, liste o abbonamenti, e non include alcun contenuto. Qui non compare nulla finché non aggiungi la tua fonte.</string>
    <string name="legal_accept">Ho letto, compreso e accetto</string>
    <string name="legal_privacy">Le credenziali della tua lista restano cifrate su questo dispositivo, non vengono mai inviate a noi e non compaiono mai nei log diagnostici.</string>
