    <string name="app_name">IPTV BURO</string>
    <string name="legal_title">Before you start</string>
    <string name="legal_body">IPTV BURO is a media player, like any other video player. It does not provide, host, resell, index or search for channels, films, series, playlists or subscriptions, and it ships with no content at all. Nothing appears here until you add your own source.</string>
    <string name="legal_accept">I have read, understood and agree</string>
    <string name="legal_privacy">Your playlist credentials are encrypted on this device, are never sent to us, and never appear in diagnostic logs.</string>
