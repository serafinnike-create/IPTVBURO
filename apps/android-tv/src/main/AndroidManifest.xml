<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Sending a title to a screen on the same network.

        ACCESS_NETWORK_STATE tells the app whether it is on wifi at all, so it can say "connect to
        the same network" instead of showing an empty device list and no reason for it.

        CHANGE_WIFI_MULTICAST_STATE is what makes discovery work: Android drops multicast and
        broadcast packets by default to save power, so without holding a multicast lock the replies
        from a receiver never reach this app. Neither permission grants access to any content, and
        neither prompts the user — both are install-time.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!--
        ACCESS_WIFI_STATE goes with the one above rather than being an extra.

        CHANGE_WIFI_MULTICAST_STATE is what *allows* a multicast lock, but taking one starts with
        `getSystemService(WIFI_SERVICE)` and `createMulticastLock`, and those need this. Without it
        the lock is never acquired, Android goes on discarding the broadcast replies, and discovery
        finds nothing at all — with no error to show for it, because the code treats an empty
        result as the ordinary "no screens here" answer.

        Install-time like the others, granting no access to content or location.
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
        The daily reminder notification.

        A runtime permission since Android 13, and asked for only when the user first marks a
        reminder — asking on first launch, before there is anything to be reminded about, is how an
        app gets refused permanently. Refusing it costs the notification and nothing else: the
        reminders still appear on the home screen and in the reminders page.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".IptvBuroApplication"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.IPTVBURO.Starting"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">

        <!--
            singleTask so a shared link reaches the app that is already running.

            Under the default launchMode Android answered every VIEW intent by stacking a *new*
            MainActivity — the task reached three of them — and a new activity builds a new, empty
            MainViewModel: no profile, no catalogue, so the link resolved against nothing and the
            app simply sat on the home screen. onNewIntent was never called because there was
            nothing to deliver an intent to.

            This also stops the launcher icon reopening a second copy over the first.
        -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!--
                Shared titles arriving as an https link.

                autoVerify makes Android check /.well-known/assetlinks.json on the domain and, once
                it matches this app's signing certificate, open the link here without the
                disambiguation dialog. Until that check passes the link opens in a browser, which is
                the same page a recipient without the app gets — so the feature degrades to the web
                page rather than breaking.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="iptvburo.pages.dev"
                    android:pathPrefix="/t/" />
            </intent-filter>

            <!--
                The private scheme. Kept separate from the verified filter above because it must not
                carry autoVerify — and it is what the web page redirects to, which is how an
                installed app is reached even on a device where domain verification has not run.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="iptvburo"
                    android:host="title" />
            </intent-filter>
        </activity>

        <!--
            WorkManager is initialised on demand, by the Application implementing
            Configuration.Provider, so its automatic initialiser has to go.

            Not cosmetic: whichever runs first wins, and the automatic one builds WorkManager with
            the default worker factory — which cannot construct a worker that has injected
            dependencies. The daily reminder would then fail on every scheduled run, while the app
            itself looked entirely healthy.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
