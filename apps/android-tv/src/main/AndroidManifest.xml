<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".IptvBuroApplication"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.IPTVBURO.Starting"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:supportsPictureInPicture="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!--
                Shared titles arriving as an https link.

                autoVerify makes Android check /.well-known/assetlinks.json on the domain and, once
                it matches this app's signing certificate, open the link here without the
                disambiguation dialog. Until that check passes the link opens in a browser, which is
                the same page a recipient without the app gets — so the feature degrades to the web
                page rather than breaking.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="iptvburo.pages.dev"
                    android:pathPrefix="/t/" />
            </intent-filter>

            <!--
                The private scheme. Kept separate from the verified filter above because it must not
                carry autoVerify — and it is what the web page redirects to, which is how an
                installed app is reached even on a device where domain verification has not run.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="iptvburo"
                    android:host="title" />
            </intent-filter>
        </activity>

    </application>

</manifest>
