<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://iptvburo.com/tizen"
        version="3.8.0"
        viewmodes="maximized">
    <name>IPTV BURO</name>
    <description>Player e organizador de midia para fontes autorizadas pelo usuario.</description>
    <author email="serafinnike@hotmail.com">Lucas Serafin</author>

    <content src="index.html"/>
    <icon src="icon.png"/>

    <!-- Obrigatorio no pre-teste do Samsung TV Seller Office. -->
    <feature name="http://tizen.org/feature/screen.size.all"/>

    <!-- 1920x1080 e a resolucao logica padrao das Samsung TV. -->
    <tizen:application id="IPTVBUROxx.IPTVBURO"
                       package="IPTVBUROxx"
                       required_version="6.0"/>

    <tizen:profile name="tv-samsung"/>

    <!--
      Recebe somente a identidade publica de um titulo compartilhado. O link
      nao contem stream nem credenciais; o app procura o titulo na fonte local
      ativa da propria TV. reload=disable preserva a sessao quando o app ja
      esta aberto e entrega o novo pedido pelo evento appcontrol.
    -->
    <tizen:app-control>
        <tizen:src name="index.html" reload="disable"/>
        <tizen:operation name="http://tizen.org/appcontrol/operation/view"/>
        <tizen:uri name="iptvburo"/>
    </tizen:app-control>

    <!-- AVPlay e a engine de video nativa da Samsung. -->
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>

    <!--
      Download para armazenamento USB.

      O armazenamento interno do app e pequeno demais para video, entao o
      download so e oferecido quando ha um pendrive ou HD montado. Sem estes
      tres privilegios a API nem sequer aparece no runtime.
    -->
    <tizen:privilege name="http://tizen.org/privilege/download"/>
    <tizen:privilege name="http://tizen.org/privilege/filesystem.read"/>
    <tizen:privilege name="http://tizen.org/privilege/filesystem.write"/>

    <!-- Teclas do controle remoto que o app precisa receber. -->
    <tizen:setting screen-orientation="landscape"
                   context-menu="disable"
                   background-support="disable"
                   encryption="disable"
                   hwkey-event="enable"/>

    <!-- Streams do usuario podem vir de qualquer host autorizado por ele. -->
    <access origin="*" subdomains="true"/>
</widget>
