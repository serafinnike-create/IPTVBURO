# Gradle
.gradle/
.kotlin/
**/build/
build/

# Local Android configuration
local.properties

# Android Studio / IntelliJ
.idea/
*.iml
captures/

# Local editor settings
.vscode/

# Tizen Studio (Eclipse) usa `apps/` como workspace, entao escreve estes diretorios de estado
# ali dentro. Sao caches locais da IDE — indices, logs e preferencias desta maquina.
apps/.metadata/
apps/.recommenders/
**/.settings/

# Signing material and secrets
*.jks
*.keystore
*.p12
keystore.properties
.env
.env.*
!.env.example
**/.dev.vars
**/.wrangler/
**/node_modules/

# Native / OS files
.cxx/
.externalNativeBuild/
.DS_Store
Thumbs.db

# Logs and generated release artifacts
*.log
artifacts/

# Tizen build output. `.buildResult` is the staged copy of the app and `*.wgt` is the signed
# package built from it — both are regenerated by `tizen build-web` / `tizen package`, and the
# .wgt additionally embeds the author signature, so neither belongs in version control.
.buildResult/
*.wgt

# Chromium writes these beside the working directory when the embedded browser runs. They are a
# SQLite store of per-device media identifiers from the developer's own machine — nothing to do
# with the product, and not something to publish.
MediaDeviceSalts
MediaDeviceSalts-journal

# Partial downloads. The download manager writes `<name>.part` while a file is in flight and renames
# it on completion, so anything matching this is by definition an unfinished copy of licensed
# content from somebody's own subscription.
*.part

# Anything written while setting up the licence server. These files hold the admin token and the
# Stripe webhook secret in plain text; they are meant to be deleted after use, and this makes a
# forgotten one impossible to commit by accident.
token-buro.txt
whsec.txt
